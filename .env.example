# [api-settings]
API_HOST: 0.0.0.0
API_PORT: 8000

# [database-settings]
POSTGRES_DB: musichub
POSTGRES_USER: username
POSTGRES_PASSWORD: password

# [database-connection]
DATABASE_HOST: postgres    # not required
DATABASE_URL: "postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DATABASE_HOST}:5432/${POSTGRES_DB}"

# [object-storage-settings]
OBJECT_STORAGE_ACCESS_KEY: rustfsadmin
OBJECT_STORAGE_SECRET_KEY: change-me-please
