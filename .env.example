COMPOSE_PROFILES:
MIGRATIONS_ENABLED: false

# [api-settings]
API_HOST: 0.0.0.0
API_PORT: 8000

# [application-settings]
APP_JWT_SECRET_KEY: my-jwt-secret-key
APP_JWT_EXPIRES_IN_TIME: 1
APP_SOUNDFONT: FluidR3_GM.sf2

# [database-settings]
POSTGRES_DB: musichub
POSTGRES_USER: username
POSTGRES_PASSWORD: password

# [database-connection]
DATABASE_HOST: postgres
DATABASE_URL: "postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DATABASE_HOST}:5432/${POSTGRES_DB}"

# [object-storage-settings]
RUSTFS_HOST: rustfs
RUSTFS_PORT: 9000
RUSTFS_ACCESS_KEY: rustfsadmin
RUSTFS_SECRET_KEY: change-me-please
RUSTFS_PUBLIC_URL: "http://localhost:${RUSTFS_PORT}"
RUSTFS_URL_EXPIRES_IN_TIME: 60
